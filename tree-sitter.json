{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "json5_orchard",
      "camelcase": "Json5Orchard",
      "title": "JSON5",
      "scope": "source.json5",
      "file-types": [
        "json5"
      ],
      "injection-regex": "^json5$",
      "class-name": "TreeSitterJson5Orchard"
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "JSON5 grammar for tree-sitter (grammar-orchard fork)",
    "authors": [
      {
        "name": "Joaqu\u00edn Le\u00f3n",
        "email": "joaquinandresleon108@gmail.com"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/grammar-orchard/tree-sitter-json5-orchard",
      "upstream": "https://github.com/Joakker/tree-sitter-json5",
      "github_mirror": "https://github.com/grammar-orchard/tree-sitter-json5-orchard"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
